# Flask Configuration
SECRET_KEY=generate-your-own-secret-key-here

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_PORT=3306
MYSQL_DB=myproctor
MYSQL_CURSORCLASS=DictCursor

# Flask-Mail Configuration (for email notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Stripe Configuration (Optional - payment system currently disabled)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Flask Session Configuration
SESSION_TYPE=filesystem
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
SESSION_PERMANENT=True
PERMANENT_SESSION_LIFETIME=604800

# Application Settings
TEMPLATES_AUTO_RELOAD=True
DEBUG=False
TESTING=False

# Domain/URL Configuration
YOUR_DOMAIN=http://localhost:5000
SERVER_NAME=localhost:5000

# Upload Settings
MAX_CONTENT_LENGTH=16777216

# Security
WTF_CSRF_SECRET_KEY=generate-your-own-csrf-key-here
