# Flask session configuration
SESSION_TYPE=filesystem
SESSION_FILE_DIR=flask_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
SESSION_PERMANENT=True
PERMANENT_SESSION_LIFETIME=604800

# Stripe configuration (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Exam/result settings
RESULT_PASS_PERCENTAGE=40

# Model backend selection
# Supported values:
# PROCTOR_FACE_BACKEND: auto, mediapipe, retinaface, opencv
# PROCTOR_LANDMARK_BACKEND: auto, mediapipe, tensorflow
# PROCTOR_FACE_MATCH_BACKEND: auto, insightface, deepface
# PROCTOR_OBJECT_BACKEND: auto, ultralytics, yolov8, yolov11, yolov3
#
# auto is the default. It uses the first available upgraded backend and falls
# back to the legacy OpenCV/TensorFlow/YOLOv3 path when the upgraded backend is
# unavailable or fails to initialize.
PROCTOR_FACE_BACKEND=auto
PROCTOR_LANDMARK_BACKEND=auto
PROCTOR_FACE_MATCH_BACKEND=auto
PROCTOR_OBJECT_BACKEND=auto

# Custom object model configuration
# PROCTOR_OBJECT_MODEL_PATH has priority when it points to an existing local
# file. Otherwise PROCTOR_OBJECT_MODEL_NAME is passed to Ultralytics. The
# default yolov8n.pt may be downloaded by Ultralytics on first use.
PROCTOR_OBJECT_MODEL_PATH=
PROCTOR_OBJECT_MODEL_NAME=yolov8n.pt

# Face verification and liveness thresholds
FACE_MATCH_THRESHOLD=66
EAR_LIVENESS_THRESHOLD=0.10
FACE_MIN_AREA_RATIO=0.08
FACE_MIN_BLUR_VARIANCE=45
FACE_MIN_BRIGHTNESS=45
FACE_MAX_BRIGHTNESS=220
FACE_MAX_CENTER_OFFSET=0.22

# Proctoring thresholds
PROCTOR_COOLDOWN_SECS=10
PROCTOR_AUDIO_THRESHOLD=18
PROCTOR_LOW_LIGHT_THRESHOLD=35
PROCTOR_LOOK_AWAY_SECONDS=6
PROCTOR_HEAD_REPEAT_COUNT=3
PROCTOR_EVENT_COOLDOWN_SECONDS=8
PROCTOR_FACE_OUT_OF_FRAME_SECONDS=4
PROCTOR_FACE_PARTIAL_SECONDS=5
PROCTOR_HEAD_MOVE_WINDOW_SECONDS=10
PROCTOR_HEAD_YAW_THRESHOLD=25
PROCTOR_HEAD_PITCH_THRESHOLD=20
PROCTOR_HEAD_TURN_SECONDS=3
PROCTOR_HEAD_MOVE_REPEAT_COUNT_NEW=6
PROCTOR_GAZE_WARNING_SECONDS=2
PROCTOR_GAZE_DEVIATION_SECONDS=2
PROCTOR_GAZE_DEVIATION_WINDOW_SECONDS=8
PROCTOR_GAZE_DEVIATION_REPEAT_COUNT=7
PROCTOR_CALIBRATION_SECONDS=5
PROCTOR_ABSENT_SECONDS=4
PROCTOR_FACE_HIDDEN_SECONDS=3
YOLO_PHONE_SCORE_MIN=0.52
YOLO_BOOK_SCORE_MIN=0.48
YOLO_PERSON_SCORE_MIN=0.38
