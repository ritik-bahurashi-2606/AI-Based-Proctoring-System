# Flask Configuration
SECRET_KEY=generate-your-own-secret-key-here

# MySQL Database Configuration
MYSQL_HOST=mysql
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_PORT=3306
MYSQL_DB=myproctor
MYSQL_CURSORCLASS=DictCursor

# Flask-Mail Configuration (for email notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Stripe Configuration (Optional - payment system currently disabled)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Flask Session Configuration
SESSION_TYPE=filesystem
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
SESSION_PERMANENT=True
PERMANENT_SESSION_LIFETIME=604800

# Application Settings
TEMPLATES_AUTO_RELOAD=True
DEBUG=False
TESTING=False

# Domain/URL Configuration
YOUR_DOMAIN=http://localhost:5000
SERVER_NAME=localhost:5000

# Upload Settings
MAX_CONTENT_LENGTH=16777216

# Security
WTF_CSRF_SECRET_KEY=generate-your-own-csrf-key-here

# ── Face Verification & Liveness Detection ─────────────────────────────────────
# Minimum face-match score (0–100%) required to allow login.
FACE_MATCH_THRESHOLD=66

# Eye Aspect Ratio threshold for liveness detection (eyes must be open).
EAR_LIVENESS_THRESHOLD=0.10

# Minimum fraction of frame that the face must occupy (too small = too far).
FACE_MIN_AREA_RATIO=0.08

# Minimum Laplacian variance (higher = sharper image; reject if below this).
FACE_MIN_BLUR_VARIANCE=75

# Acceptable brightness range for the face region (grayscale 0-255).
FACE_MIN_BRIGHTNESS=45
FACE_MAX_BRIGHTNESS=220

# Maximum allowed offset of face center from frame center (fraction of width).
FACE_MAX_CENTER_OFFSET=0.22
